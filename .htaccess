# ==============================================
# MakeProjects.in — Apache Rewrite Rules
# SEO: HTTPS enforcement, www redirect,
#      /index.html → / canonical redirect,
#      trailing-slash consistency,
#      custom 404 page
# ==============================================

# Enable RewriteEngine
RewriteEngine On

# --- 1. Force HTTPS ---
RewriteCond %{HTTP_HOST} !=localhost
RewriteCond %{HTTP_HOST} !=127.0.0.1
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- 2. Redirect www to non-www ---
RewriteCond %{HTTP_HOST} ^www\.makeprojects\.in$ [NC]
RewriteRule ^ https://makeprojects.in%{REQUEST_URI} [R=301,L]

# --- 3. Redirect /index.html to / (canonical homepage) ---
RewriteRule ^index\.html$ / [R=301,L]

# --- 4. Custom 404 page ---
ErrorDocument 404 /404.html

# --- 4.5. Fix Sitemap XML Content-Type ---
<IfModule mod_mime.c>
    AddType application/xml .xml
</IfModule>

# --- 5. Security headers ---
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- 6. Cache static assets ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# --- 7. Enable Gzip compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml image/svg+xml
</IfModule>
